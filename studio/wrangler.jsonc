{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeta-cyod---leave-the-citadel",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeta-manuscript",
      "database_id": "3ab9afed-9fe2-4c05-99e8-162c3d1cc5f2",
      "migrations_dir": "migrations"
    }
  ]
}
